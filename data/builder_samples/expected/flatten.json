{
  "source_path": "orders_nested.json",
  "explode_strategy": "per_array_explode_with_foreign_key_propagation",
  "result_tables": [
    {
      "table_name": "orders",
      "row_count": 16,
      "primary_key": "order_id",
      "columns": [
        "order_id",
        "customer_id",
        "customer_name",
        "order_date",
        "status",
        "total_amount",
        "currency",
        "cancel_reason"
      ],
      "notes": "shipping 与 notes 被下沉为独立子表；null 字段保留；ORD-0007 cancelled 的 cancel_reason 保留"
    },
    {
      "table_name": "order_items",
      "row_count": 29,
      "primary_key": [
        "order_id",
        "line_no"
      ],
      "foreign_keys": [
        {
          "column": "order_id",
          "references": "orders.order_id",
          "cardinality": "N:1"
        }
      ],
      "columns": [
        "order_id",
        "line_no",
        "product_id",
        "sku",
        "qty",
        "unit_price",
        "line_amount"
      ],
      "notes": "每订单 items 数组 Explode 为多行；ORD-0007 因 items=[] 产生 0 行（cancelled 订单可保留空 items）"
    },
    {
      "table_name": "order_shippings",
      "row_count": 12,
      "primary_key": "order_id",
      "foreign_keys": [
        {
          "column": "order_id",
          "references": "orders.order_id",
          "cardinality": "1:1"
        }
      ],
      "columns": [
        "order_id",
        "carrier_id",
        "carrier_name",
        "vehicle_type",
        "planned_pickup",
        "planned_delivery",
        "tracking_no",
        "cost"
      ],
      "notes": "1:1 关系；4 个订单（ORD-0005/0007/0010/0015）无 shipping 不入表；shipping.carrier_id 期望做 FK 检测（参考 suppliers_supplier_id），部分 carrier_id 含无连字符格式（SUP012/SUP008/SUP-013 等）"
    },
    {
      "table_name": "order_notes",
      "row_count": 3,
      "primary_key": [
        "order_id",
        "note_seq"
      ],
      "foreign_keys": [
        {
          "column": "order_id",
          "references": "orders.order_id",
          "cardinality": "N:1"
        }
      ],
      "columns": [
        "order_id",
        "note_seq",
        "timestamp",
        "author",
        "text",
        "has_replies"
      ],
      "notes": "本订单（ORD-0005）3 条顶层 note，含 1 条带 replies 的 note，replies 字段被替换为 has_replies 布尔标记；双层嵌套在第二阶段 Explode 为 order_note_replies"
    },
    {
      "table_name": "order_note_replies",
      "row_count": 2,
      "primary_key": [
        "order_id",
        "note_seq",
        "timestamp"
      ],
      "foreign_keys": [
        {
          "column": "order_id",
          "references": "orders.order_id",
          "cardinality": "N:1"
        },
        {
          "column": [
            "order_id",
            "note_seq"
          ],
          "references": "order_notes.[order_id,note_seq]",
          "cardinality": "N:1"
        }
      ],
      "columns": [
        "order_id",
        "note_seq",
        "timestamp",
        "author",
        "text"
      ],
      "notes": "Explode 双层嵌套数组的输出；当前数据集仅 ORD-0005 含 replies 数组 → 2 行"
    }
  ],
