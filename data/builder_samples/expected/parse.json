{
  "source_path": "catalog.xml",
  "parse_strategy": "nested_element_to_child_table_with_attribute_and_text",
  "result_tables": [
    {
      "table_name": "products",
      "row_count": 12,
      "primary_key": "product_id",
      "columns": [
        "product_id",
        "sku",
        "name",
        "category_path",
        "category_label",
        "brand",
        "unit",
        "list_price",
        "currency",
        "origin",
        "status"
      ]
    },
    {
      "table_name": "product_specs",
      "row_count": 33,
      "primary_key": [
        "product_id",
        "spec_seq"
      ],
      "foreign_keys": [
        {
          "column": "product_id",
          "references": "products.product_id",
          "cardinality": "N:1"
        }
      ],
      "columns": [
        "product_id",
        "spec_seq",
        "spec_key",
        "spec_value",
        "spec_unit"
      ],
      "notes": "specs 子元素 Explode；空 unit 处理为 null"
    },
    {
      "table_name": "product_certifications",
      "row_count": 12,
      "primary_key": [
        "product_id",
        "cert_seq"
      ],
      "foreign_keys": [
        {
          "column": "product_id",
          "references": "products.product_id",
          "cardinality": "N:1"
        }
      ],
      "columns": [
        "product_id",
        "cert_seq",
        "cert_id",
        "cert_text"
      ],
      "notes": "空 certifications 节点（X-9003/X-9004/X-9006）不产生 cert 行"
    }
  ],
  "metadata_table": {
    "table_name": "catalog_metadata",
    "row_count": 1,
    "primary_key": "vendor",
    "columns": [
      "vendor",
      "region_coverage",
      "last_sync",
      "version",
      "exported_at",
      "source_system"
    ],
    "notes": "根节点属性与 metadata 子元素提取；不参与下游对象建模"
  },
