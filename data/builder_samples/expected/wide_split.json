      "row_count": 14,
      "primary_key": "purchase_order_id",
      "columns": [
        "purchase_order_id",
        "po_date",
        "po_status",
        "po_total_amount",
        "supplier_id",
        "buyer",
        "warehouse_code"
      ],
      "split_rule": "取每 PO 首行的订单头字段；supplier_id 保留作 FK；po_total_amount 字段名与原宽表一致，不分摊到明细",
      "expected_keys": [
        "PO-20250801-001",
        "PO-20250803-002",
        "PO-20250805-003",
        "PO-20250807-004",
        "PO-20250810-005",
        "PO-20250812-006",
